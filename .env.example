# Copy this file to .env and fill in the environment-specific values.
# Only variables prefixed with SETTLE_AFRICA_ or VITE_ are exposed to the browser bundle.
# NEVER place private server secrets here.

# Required for live API requests: Backend API base URL (no trailing slash, no /api/v1 prefix)
# Example: https://api.settleafrica.example
SETTLE_AFRICA_BASE_URL=

# Optional: Bootstrap device/client token sent in the `shell` request header
# SETTLE_AFRICA_SHELL_TOKEN=

# Optional: Request timeout in milliseconds (default: 30000)
SETTLE_AFRICA_API_TIMEOUT_MS=30000

# Optional: Set to "true" in local dev to bypass the Vite /api proxy and call SETTLE_AFRICA_BASE_URL directly
# SETTLE_AFRICA_USE_DIRECT_URL=false
